+// Shiny icons (Hall of Legends). Gen 3 icons have no shiny colors, so a shiny Pokémon's icon gets a palette of
+// its own: each colored icon color is matched by hue to the species' normal palette, and takes that color's
+// shiny hue (and saturation/brightness change) while keeping its own shading. Grays and colors that don't change
+// when shiny stay as they are.
+#define POKE_ICON_SHINY_PAL_TAG 0xDF00 // + species
+#define ICON_MIN_SAT 50                // below this (of 255) a color counts as gray
+
+struct IconHsv { s32 h, s, v; };       // hue 0-359, saturation 0-255, value 0-31
+
+static struct IconHsv IconColorToHsv(u16 color)
+{
+    s32 r = color & 31, g = (color >> 5) & 31, b = (color >> 10) & 31;
+    s32 max = max(r, max(g, b)), min = min(r, min(g, b)), d = max - min;
+    struct IconHsv hsv = {0, max ? d * 255 / max : 0, max};
+
+    if (d != 0)
+    {
+        if (max == r)
+            hsv.h = 60 * (g - b) / d;
+        else if (max == g)
+            hsv.h = 120 + 60 * (b - r) / d;
+        else
+            hsv.h = 240 + 60 * (r - g) / d;
+        hsv.h = (hsv.h % 360 + 360) % 360;
+    }
+    return hsv;
+}
+
+static u16 IconHsvToColor(s32 h, s32 s, s32 v)
+{
+    s32 region = h / 60, rem = (h % 60) * 255 / 60;
+    s32 p = v * (255 - s) / 255;
+    s32 q = v * (255 - s * rem / 255) / 255;
+    s32 t = v * (255 - s * (255 - rem) / 255) / 255;
+
+    switch (region)
+    {
+    case 0:  return RGB(v, t, p);
+    case 1:  return RGB(q, v, p);
+    case 2:  return RGB(p, v, t);
+    case 3:  return RGB(p, q, v);
+    case 4:  return RGB(t, p, v);
+    default: return RGB(v, p, q);
+    }
+}
+
+static s32 IconHueDistance(s32 a, s32 b)
+{
+    s32 d = abs(a - b) % 360;
+    return min(d, 360 - d);
+}
+
+static u16 GetShinyIconColor(u16 color, const u16 *normal, const u16 *shiny)
+{
+    struct IconHsv c = IconColorToHsv(color), n, sh;
+    s32 best = -1, bestHue = 0, bestValue = 0, j;
+
+    if (c.s < ICON_MIN_SAT || c.v < 4)
+        return color;
+    for (j = 1; j < 16; j++)
+    {
+        s32 hue, value;
+
+        n = IconColorToHsv(normal[j]);
+        if (n.s < ICON_MIN_SAT || n.v < 4)
+            continue;
+        hue = IconHueDistance(c.h, n.h);
+        value = abs(c.v - n.v);
+        if (best < 0 || hue < bestHue || (hue == bestHue && value < bestValue))
+        {
+            best = j;
+            bestHue = hue;
+            bestValue = value;
+        }
+    }
+    if (best < 0 || bestHue > 40)
+        return color;
+    n = IconColorToHsv(normal[best]);
+    sh = IconColorToHsv(shiny[best]);
+    if (IconHueDistance(n.h, sh.h) < 12 && abs(n.s - sh.s) < 40)
+        return color; // this part of the Pokémon looks the same when shiny
+    return IconHsvToColor(sh.h, min(255, c.s * sh.s / max(1, n.s)), min(31, c.v * sh.v / max(1, n.v)));
+}
+
+static u16 LoadShinyIconPalette(enum Species species, u32 personality, u16 normalTag)
+{
+    u16 tag = POKE_ICON_SHINY_PAL_TAG + species;
+
+    if (IndexOfSpritePaletteTag(tag) == 0xFF)
+    {
+        const u16 *icon = gMonIconPaletteTable[normalTag - POKE_ICON_BASE_PAL_TAG].data;
+        const u16 *normal = GetMonSpritePalFromSpeciesAndPersonality(species, FALSE, personality);
+        const u16 *shiny = GetMonSpritePalFromSpeciesAndPersonality(species, TRUE, personality);
+        u16 colors[16];
+        struct SpritePalette palette = {colors, tag};
+        u32 i;
+
+        colors[0] = icon[0];
+        for (i = 1; i < 16; i++)
+            colors[i] = GetShinyIconColor(icon[i], normal, shiny);
+        if (LoadSpritePalette(&palette) == 0xFF)
+            return normalTag; // no free palette: plain icon
+    }
+    return tag;
+}
