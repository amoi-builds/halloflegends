+// ---------------------------------------------------------------------------
+// Portraits
+
+static void GetPicPosition(u32 slot, s16 *x, s16 *y)
+{
+    static const s16 sSingleX[SLOT_COUNT] = {40, 0, 200, 0};
+    static const s16 sTagX[SLOT_COUNT] = {28, 64, 212, 176};
+
+    *x = IsTag() ? sTagX[slot] : sSingleX[slot];
+    *y = PIC_Y;
+}
+
+// What a portrait slot should show right now (a cell value).
+static u32 GetSlotDisplay(u32 slot)
+{
+    u32 active = GetActiveSlot();
+
+    if (!IsSlotUsed(slot) || sSelect->stage == STAGE_FORMAT)
+        return CELL_NONE;
+    if (sSelect->stage == STAGE_CONFIRM || sSelect->stage == STAGE_START)
+        return sSelect->resolved[slot];
+    if (slot == active)
+    {
+        u32 cell = sSelect->cells[sSelect->cursor];
+        if (cell == CELL_ELITE_FOUR && slot != SLOT_OPPONENT_1)
+            return CELL_NONE;
+        if (IsCharacterCell(cell) && !IsCellSelectable(cell)) // already picked for this side
+            return CELL_NONE;
+        return cell;
+    }
+    if (slot < active)
+        return sSelect->picks[slot];
+    return CELL_NONE;
+}
+
+static void SetPortrait(u32 slot, u32 display)
+{
+    s16 x, y;
+    u32 pic;
+    bool32 silhouette = FALSE;
+
+    if (sSelect->shown[slot] != CELL_NONE)
+    {
+        FreeAndDestroyTrainerPicSprite(sSelect->picSpriteIds[slot]);
+        sSelect->shown[slot] = CELL_NONE;
+    }
+    if (display == CELL_NONE)
+        return;
+
+    if (IsCharacterCell(display))
+    {
+        pic = gHoLCharacters[display].frontPic;
+    }
+    else
+    {
+        // Random and the Elite Four spin through silhouettes
+        pic = gHoLCharacters[sSelect->rouletteChar].frontPic;
+        silhouette = TRUE;
+    }
+    GetPicPosition(slot, &x, &y);
+    sSelect->portraitPalTurn[slot] ^= 1;
+    sSelect->picSpriteIds[slot] = CreateTrainerPicSprite(pic, TRUE, x, y, sSelect->portraitPal[slot * 2 + sSelect->portraitPalTurn[slot]], TAG_NONE);
+    gSprites[sSelect->picSpriteIds[slot]].oam.priority = 1;
+    gSprites[sSelect->picSpriteIds[slot]].subpriority = (slot == SLOT_PLAYER_1 || slot == SLOT_OPPONENT_1) ? 1 : 2;
+    // Trainer pics face left (toward you in battle): mirror your side so both sides face each other
+    if (slot < SLOT_OPPONENT_1)
+        gSprites[sSelect->picSpriteIds[slot]].hFlip = TRUE;
+    if (silhouette) // the new sprite isn't shown before the next frame, so this can't flash
+        LoadPalette(sSilhouettePalette, OBJ_PLTT_ID(gSprites[sSelect->picSpriteIds[slot]].oam.paletteNum), PLTT_SIZE_4BPP);
+    sSelect->shown[slot] = display;
+    sSelect->shownRoulette[slot] = sSelect->rouletteChar;
+}
+
+static void UpdatePortraits(void)
+{
+    u32 slot;
+
+    for (slot = 0; slot < SLOT_COUNT; slot++)
+    {
+        u32 display = GetSlotDisplay(slot);
+
+        if (display != sSelect->shown[slot])
+            SetPortrait(slot, display);
+        else if (display != CELL_NONE && !IsCharacterCell(display) && sSelect->shownRoulette[slot] != sSelect->rouletteChar)
+            SetPortrait(slot, display);
+    }
+}
+
+static void AdvanceRoulette(void)
+{
+    u32 i;
+
+    for (i = 0; i < HOL_CHAR_COUNT; i++)
+    {
+        sSelect->rouletteChar = (sSelect->rouletteChar + 1) % HOL_CHAR_COUNT;
+        if (gHoLCharacters[sSelect->rouletteChar].enabled)
+            return;
+    }
+}
