+    BreakStringAutomatic(gStringVar4, FIELD_TEXT_WIDTH, 2, FONT_NORMAL, SHOW_SCROLL_PROMPT);
+}
+
+// The team display walks slowly in place (an idle bob). Spawned on the same frame they'd bob in step, so once
+// each one has started, its current step is cut short by a different amount (sprite data[2] is the movement
+// action's state, data[3] its countdown; see InitMoveInPlace).
+#define tDone   data[0]
+#define tTimer  data[1]
+
+static void Task_StaggerTeamDisplay(u8 taskId)
+{
+    u32 i;
+
+    for (i = 0; i < HOL_TEAM_DISPLAY_COUNT; i++)
+    {
+        u8 objectId;
+        struct Sprite *sprite;
+
+        if (gTasks[taskId].tDone & (1 << i))
+            continue;
+        if (TryGetObjectEventIdByLocalIdAndMap(LOCALID_HOL_MON_1 + i, gSaveBlock1Ptr->location.mapNum, gSaveBlock1Ptr->location.mapGroup, &objectId))
+            continue; // not spawned yet
+        sprite = &gSprites[gObjectEvents[objectId].spriteId];
+        if (sprite->data[2] != 1)
+            continue; // its step hasn't started yet
+        sprite->data[3] = max(1, sprite->data[3] - (s32)i * 5);
+        gTasks[taskId].tDone |= 1 << i;
+    }
+    if (gTasks[taskId].tDone == (1 << HOL_TEAM_DISPLAY_COUNT) - 1 || ++gTasks[taskId].tTimer > 120)
+        DestroyTask(taskId);
+}
+
+#undef tDone
+#undef tTimer
+
