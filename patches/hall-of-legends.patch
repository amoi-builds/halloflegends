+
+#define FIELD_TEXT_WIDTH 208 // standard message box
+
+EWRAM_DATA struct HoLRun gHoLRun = {0};
+static EWRAM_DATA u16 sTeamDisplaySpecies[HOL_TEAM_DISPLAY_COUNT] = {0};
+
+// The battle engine doesn't wrap text it inserts (trainer quotes), so they're wrapped beforehand.
+enum
+{
+    BATTLE_TEXT_DEFEAT_A,
+    BATTLE_TEXT_DEFEAT_B,
+    BATTLE_TEXT_VICTORY_A,
+    BATTLE_TEXT_VICTORY_B,
+    BATTLE_TEXT_COUNT,
+};
+static EWRAM_DATA u8 sBattleTexts[BATTLE_TEXT_COUNT][256] = {0};
+
+#include "data/hall_of_legends.h"
+
+// Where the trainer(s) and their team stand in each league room.
+// In tag battles trainer A's three Pokémon use the first three spots (the left side).
+struct HoLRoomLayout
+{
+    u8 trainerX;
+    u8 trainerY;
+    u8 tagX[2];                         // tag battles: side by side, so you and your partner can face them
+    u8 monX[HOL_TEAM_DISPLAY_COUNT];
+    u8 monY[HOL_TEAM_DISPLAY_COUNT];
+};
+
+#define E4_ROOM_LAYOUT(y) {6, (y), {6, 7}, {3, 5, 4, 7, 9, 8}, {(y) - 2, (y) - 2, (y) - 1, (y) - 2, (y) - 2, (y) - 1}}
+
+static const struct HoLRoomLayout sRoomLayouts[HOL_E4_ROOM_COUNT] =
+{
+    E4_ROOM_LAYOUT(6), // Lorelei
+    E4_ROOM_LAYOUT(6), // Bruno
+    E4_ROOM_LAYOUT(6), // Agatha
+    E4_ROOM_LAYOUT(9), // Lance
+    E4_ROOM_LAYOUT(8), // Champion
+};
+
+// Healing items for an Elite Four run. Nothing else can be used in battle.
+static const u16 sEliteFourItems[][2] =
+{
+    {ITEM_FULL_RESTORE, 7},
+    {ITEM_REVIVE, 4},
+    {ITEM_MAX_REVIVE, 2},
+    {ITEM_MAX_ELIXIR, 3},
+};
+
+static bool32 IsTagBattle(void)
+{
+    return gHoLRun.format == HOL_FORMAT_TAG;
+}
+
+// The opponent(s) standing in the current room. slot 1 is only used by tag battles in a versus run.
+u32 HoL_GetLeagueRoomOpponent(u32 slot)
+{
+    if (gHoLRun.runType == HOL_RUN_ELITE_FOUR)
+        return slot == 0 ? gHoLRun.eliteFour[gHoLRun.room] : HOL_CHAR_NONE;
+    if (slot == 1 && !IsTagBattle())
+        return HOL_CHAR_NONE;
+    return gHoLRun.opponents[slot];
+}
+
+// ---------------------------------------------------------------------------
+// Parties
+
+static void CreateCharacterMons(struct Pokemon *party, u32 character, const u8 *slots, u32 count, bool32 forPlayer)
+{
+    const struct HoLCharacter *info = &gHoLCharacters[character];
+    const struct Trainer *trainer = GetTrainerStructFromId(info->trainerId);
+    struct TrainerGenerator gen = {0}; // MakeTrainerGenerator only sets the fields it needs
+    u32 i;
+
+    MakeTrainerGenerator(&gen, trainer);
+    if (forPlayer)
+    {
+        // Owned by the player, so they always obey. The OT shows whose team it is.
+        gen.otID = OTID_STRUCT_PLAYER_ID;
+        StringCopyN(gen.name, info->name, TRAINER_NAME_LENGTH + 1);
+        gen.gender = info->gender;
+    }
+
+    for (i = 0; i < count; i++)
+        GenerateMonFromTrainerMon(&party[i], &trainer->party[slots[i]], &gen);
+}
+
+static void CreateFullTeam(struct Pokemon *party, u32 character, bool32 forPlayer)
+{
+    static const u8 sAllSlots[PARTY_SIZE] = {0, 1, 2, 3, 4, 5};
+    u32 count = GetTrainerStructFromId(gHoLCharacters[character].trainerId)->partySize;
+
+    CreateCharacterMons(party, character, sAllSlots, min(count, PARTY_SIZE), forPlayer);
+}
+
+static void BuildPlayerParty(void)
+{
+    ZeroPlayerPartyMons();
+    if (IsTagBattle())
+    {
+        // Leads first, so each trainer's lead starts on their own side of the field.
+        struct Pokemon *mons = AllocZeroed(sizeof(struct Pokemon) * PARTY_SIZE);
+        CreateCharacterMons(&mons[0], gHoLRun.players[0], gHoLCharacters[gHoLRun.players[0]].iconic, 3, TRUE);
+        CreateCharacterMons(&mons[3], gHoLRun.players[1], gHoLCharacters[gHoLRun.players[1]].iconic, 3, TRUE);
+        gParties[B_TRAINER_PLAYER][0] = mons[0];
+        gParties[B_TRAINER_PLAYER][1] = mons[3];
+        gParties[B_TRAINER_PLAYER][2] = mons[1];
+        gParties[B_TRAINER_PLAYER][3] = mons[2];
+        gParties[B_TRAINER_PLAYER][4] = mons[4];
+        gParties[B_TRAINER_PLAYER][5] = mons[5];
+        Free(mons);
+    }
+    else
+    {
+        CreateFullTeam(gParties[B_TRAINER_PLAYER], gHoLRun.players[0], TRUE);
+    }
+    CalculatePlayerPartyCount();
+}
+
+// Called from DoTrainerBattle. Two opponents bring their three iconic Pokémon each.
+bool32 HoL_CreateOpponentParties(void)
+{
+    u32 a, b;
+
+    if (!HoL_IsActive())
+        return FALSE;
+
+    a = HoL_GetLeagueRoomOpponent(0);
+    b = HoL_GetLeagueRoomOpponent(1);
+    ZeroEnemyPartyMons();
+    if (b == HOL_CHAR_NONE)
+    {
+        CreateFullTeam(gParties[B_TRAINER_OPPONENT_A], a, FALSE);
+    }
+    else
+    {
+        CreateCharacterMons(&gParties[B_TRAINER_OPPONENT_A][0], a, gHoLCharacters[a].iconic, 3, FALSE);
+        CreateCharacterMons(&gParties[B_TRAINER_OPPONENT_B][0], b, gHoLCharacters[b].iconic, 3, FALSE);
+    }
+    return TRUE;
+}
+
+// Tag battles against two trainers: after the intro (each trainer sends out their own lead) their Pokémon
+// become one team of six, so a side of the field is never left empty while either trainer has Pokémon.
+// From then on it's a double battle against trainer A, with trainer B's Pokémon in A's slots 3-5.
+// The end of battle still shows both trainers (gHoLOpponentsMerged is checked where TWO_OPPONENTS was).
+EWRAM_DATA u8 gHoLOpponentsMerged = FALSE;
+
+void HoL_MergeOpponentTeams(void)
+{
+    enum BattlerId right = GetBattlerAtPosition(B_POSITION_OPPONENT_RIGHT);
+    u32 i;
+
+    gHoLOpponentsMerged = FALSE;
+    if (!HoL_IsActive() || !(gBattleTypeFlags & BATTLE_TYPE_TWO_OPPONENTS) || TRAINER_BATTLE_PARAM.opponentB == TRAINER_NONE)
+        return;
+    for (i = 0; i < MULTI_PARTY_SIZE; i++)
+    {
+        u32 slot = MULTI_PARTY_SIZE + i;
+
+        gParties[B_TRAINER_OPPONENT_A][slot] = gParties[B_TRAINER_OPPONENT_B][i];
+        gBattleStruct->partyState[B_TRAINER_OPPONENT_A][slot] = gBattleStruct->partyState[B_TRAINER_OPPONENT_B][i];
+        gBattleStruct->itemLost[B_TRAINER_OPPONENT_A][slot] = gBattleStruct->itemLost[B_TRAINER_OPPONENT_B][i];
+        gBattleStruct->gimmick.activeGimmick[B_TRAINER_OPPONENT_A][slot] = gBattleStruct->gimmick.activeGimmick[B_TRAINER_OPPONENT_B][i];
+        gAiPartyData->mons[B_TRAINER_OPPONENT_A][slot] = gAiPartyData->mons[B_TRAINER_OPPONENT_B][i];
+    }
+    gAiPartyData->count[B_TRAINER_OPPONENT_A] += gAiPartyData->count[B_TRAINER_OPPONENT_B];
+    gPartiesCount[B_TRAINER_OPPONENT_A] = CalculatePartyCount(B_TRAINER_OPPONENT_A);
+    gBattlerPartyIndexes[right] += MULTI_PARTY_SIZE;
+    gBattleTypeFlags &= ~BATTLE_TYPE_TWO_OPPONENTS;
+    gHoLOpponentsMerged = TRUE;
+}
+
+// Which opponent a merged-team Pokémon came from (for "X sent out ...").
+bool32 HoL_IsTrainerBMon(u32 battler)
+{
+    return gHoLOpponentsMerged && !IsOnPlayerSide(battler) && gBattlerPartyIndexes[battler] >= MULTI_PARTY_SIZE;
+}
