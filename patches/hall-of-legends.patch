+// ---------------------------------------------------------------------------
+// Team preview (the Pokémon of the trainer under the cursor)
+
+static void DestroyTeamIcons(void)
+{
+    u32 i;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (sSelect->iconSpriteIds[i] != SPRITE_NONE)
+        {
+            FreeAndDestroyMonIconSprite(&gSprites[sSelect->iconSpriteIds[i]]);
+            sSelect->iconSpriteIds[i] = SPRITE_NONE;
+        }
+    }
+    sSelect->iconsFor = CELL_NONE;
+}
+
+static void UpdateTeamIcons(void)
+{
+    u32 slot = GetActiveSlot();
+    u32 character = CELL_NONE;
+    const struct Trainer *trainer;
+    u32 i;
+
+    if (slot != SLOT_COUNT && IsCharacterCell(sSelect->cells[sSelect->cursor]))
+        character = sSelect->cells[sSelect->cursor];
+    if (character == sSelect->iconsFor)
+        return;
+
+    DestroyTeamIcons();
+    if (character == CELL_NONE)
+        return;
+
+    trainer = GetTrainerStructFromId(gHoLCharacters[character].trainerId);
+    if (IsTag())
+    {
+        // Only the three iconic Pokémon come along in tag battles
+        for (i = 0; i < 3; i++)
+        {
+            const struct TrainerMon *mon = &trainer->party[gHoLCharacters[character].iconic[i]];
+            sSelect->iconSpriteIds[i] = CreateMonIconIsEggShiny(mon->species, SpriteCB_MonIcon, 96 + i * 24, 52, 0, 0, FALSE, mon->isShiny);
+        }
+        for (i = 0; i < 3; i++)
+            gSprites[sSelect->iconSpriteIds[i]].oam.priority = 0;
+    }
+    else
+    {
+        for (i = 0; i < trainer->partySize && i < PARTY_SIZE; i++)
+        {
+            sSelect->iconSpriteIds[i] = CreateMonIconIsEggShiny(trainer->party[i].species, SpriteCB_MonIcon, 96 + (i % 3) * 24, 38 + (i / 3) * 28, 0, 0, FALSE, trainer->party[i].isShiny);
+            gSprites[sSelect->iconSpriteIds[i]].oam.priority = 0;
+        }
+    }
+    sSelect->iconsFor = character;
+}
