diff --git a/include/hall_of_legends.h b/include/hall_of_legends.h
new file mode 100644
index 000000000..6b0f296a4
--- /dev/null
+++ b/include/hall_of_legends.h
@@ -0,0 +1,78 @@
+#ifndef GUARD_HALL_OF_LEGENDS_H
+#define GUARD_HALL_OF_LEGENDS_H
+
+#include "constants/hall_of_legends.h"
+
+// Hall of Legends: pick legendary trainers, then battle one of them in the Champion's room
+// or run the Elite Four with five random ones.
+
+struct HoLCharacter
+{
+    const u8 *name;
+    const u8 *introText;    // overworld, before the battle
+    const u8 *defeatText;   // in battle, when they lose
+    const u8 *victoryText;  // in battle, when they win
+    const u8 *postText;     // overworld, after losing
+    u16 trainerId;          // their team (6 Pokémon) in src/data/trainers_frlg.party
+    u16 objGfx;             // overworld sprite
+    u16 frontPic;           // TRAINER_PIC_*
+    u16 backPic;            // TRAINER_PIC_* with a back pic, or TRAINER_PIC_NONE (no sprite on your side in battle)
+    u8 gender;
+    u8 iconic[3];           // party slots used when two trainers team up (3 Pokémon each)
+    u8 faceX;               // the face in the front pic (pixels: center x, eye line y), for the select grid
+    u8 faceY;
+    bool8 enabled;          // FALSE hides them from the select screen (no sprites yet)
+};
+
+struct HoLRun
+{
+    bool8 active;           // keep first: data/battle_scripts_1.s reads it at gHoLRun
+    u8 format;              // HOL_FORMAT_*
+    u8 runType;             // HOL_RUN_*
+    u8 players[2];          // players[1] is HOL_CHAR_NONE unless format is HOL_FORMAT_TAG
+    u8 opponents[2];        // versus run; opponents[1] only for HOL_FORMAT_TAG
+    u8 eliteFour[HOL_E4_ROOM_COUNT];
+    u8 room;                // Elite Four progress, 0..HOL_ROOM_CHAMPION
+};
+
+extern const struct HoLCharacter gHoLCharacters[HOL_CHAR_COUNT];
+extern struct HoLRun gHoLRun;
+
+static inline bool32 HoL_IsActive(void)
+{
+    return IS_FRLG && gHoLRun.active;
+}
+
+// Tag battles: your second trainer stands on the right and throws their own Pokémon.
+static inline bool32 HoL_PlayerHasPartner(void)
+{
+    return HoL_IsActive() && gHoLRun.format == HOL_FORMAT_TAG;
