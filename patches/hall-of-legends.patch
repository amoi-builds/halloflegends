+    PrintSideNames(WIN_NAME_LEFT, SLOT_PLAYER_1, SLOT_PLAYER_2, sColor_Red);
+    PrintSideNames(WIN_NAME_RIGHT, SLOT_OPPONENT_1, SLOT_OPPONENT_2, sColor_Blue);
+    PrintCenter();
+    PrintCellLabels();
+}
+
+// Tag battles, second pick: the trainer already on that side can't be picked again, so its face is darkened.
+static void UpdateFaceDimming(void)
+{
+    u32 i;
+
+    for (i = 0; i < sSelect->numCells && IsCharacterCell(sSelect->cells[i]); i++)
+    {
+        bool32 dim = IsSecondPick() && !IsCellSelectable(sSelect->cells[i]);
+        u32 offset = BG_PLTT_ID(PAL_FACE(i));
+
+        if (dim == ((sSelect->dimmedFaces >> i) & 1))
+            continue;
+        if (dim)
+            BlendPalettesFine(1, &gPlttBufferUnfaded[offset], &gPlttBufferFaded[offset], 10, sBgPalette[COLOR_BACKDROP]);
+        else
+            CpuCopy16(&gPlttBufferUnfaded[offset], &gPlttBufferFaded[offset], PLTT_SIZE_4BPP);
+        sSelect->dimmedFaces ^= 1 << i;
+    }
+}
+
+static void Refresh(void)
+{
+    UpdateFaceDimming();
+    UpdatePortraits();
+    UpdateTeamIcons();
+    PrintAll();
+    UpdateCursor();
+}
