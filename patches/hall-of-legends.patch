+static void PrintCenter(void)
+{
+    u32 i;
+
+    FillWindowPixelBuffer(WIN_CENTER, PIXEL_FILL(0));
+    if (sSelect->showCredits)
+    {
+        u32 page = sSelect->showCredits - 1;
+        AddTextPrinterParameterized3(WIN_CENTER, FONT_SMALL, 4, 2, sColor_White, TEXT_SKIP_DRAW, sCreditPages[page]);
+        AddTextPrinterParameterized3(WIN_CENTER, FONT_SMALL, 188 - GetStringWidth(FONT_SMALL, sCreditPageNumbers[page], 0), 50, sColor_Light, TEXT_SKIP_DRAW, sCreditPageNumbers[page]);
+    }
+    else if (sSelect->stage == STAGE_FORMAT)
+    {
+        for (i = 0; i < ARRAY_COUNT(sFormatNames); i++)
+        {
+            const u8 *color = i == sSelect->formatCursor ? sColor_Gold : sColor_White;
+            if (i == sSelect->formatCursor)
+                AddTextPrinterParameterized3(WIN_CENTER, FONT_NORMAL, 52, i * 14 + 4, sColor_Red, TEXT_SKIP_DRAW, sText_Cursor);
+            AddTextPrinterParameterized3(WIN_CENTER, FONT_NORMAL, 64, i * 14 + 4, color, TEXT_SKIP_DRAW, sFormatNames[i]);
+        }
+        PrintCentered(WIN_CENTER, sFormatDescs[sSelect->formatCursor], 50, sColor_Light);
+    }
+    else if (sSelect->stage == STAGE_CONFIRM)
+    {
+        PrintCentered(WIN_CENTER, sText_VS, 24, sColor_Gold);
