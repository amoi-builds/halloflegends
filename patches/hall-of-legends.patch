+u16 HoL_GetPartnerFrontPic(void)
+{
+    return gHoLCharacters[gHoLRun.players[1]].frontPic;
+}
+
+// A player's back pic in battle (player 1 is your partner in tag battles).
+// Trainers without one are left out; in tag battles both are, unless both have one.
+u16 HoL_GetPlayerBackPic(u32 player)
+{
+    if (gHoLCharacters[gHoLRun.players[0]].backPic == TRAINER_PIC_NONE)
+        return TRAINER_PIC_HOL_BLANK;
+    if (IsTagBattle() && gHoLCharacters[gHoLRun.players[1]].backPic == TRAINER_PIC_NONE)
+        return TRAINER_PIC_HOL_BLANK;
+    return gHoLCharacters[gHoLRun.players[player]].backPic;
+}
+
+const u8 *HoL_GetPlayerName(void)
+{
+    return gHoLCharacters[gHoLRun.players[0]].name;
+}
+
+const u8 *HoL_GetPartnerName(void)
+{
+    return gHoLCharacters[gHoLRun.players[1]].name;
+}
+
+// In an Elite Four run everyone but the last trainer is an Elite Four member.
+u8 HoL_GetTrainerClassOverride(u8 trainerClass)
+{
+    if (HoL_IsActive() && gHoLRun.runType == HOL_RUN_ELITE_FOUR && gHoLRun.room != HOL_ROOM_CHAMPION
+     && trainerClass == TRAINER_CLASS_CHAMPION_FRLG)
+        return TRAINER_CLASS_ELITE_FOUR_FRLG;
+    return trainerClass;
+}
+
+const u8 *HoL_GetTrainerBWinText(void)
+{
+    if (HoL_GetLeagueRoomOpponent(1) == HOL_CHAR_NONE)
+        return gText_EmptyString2;
+    return sBattleTexts[BATTLE_TEXT_VICTORY_B];
+}
+
+static u8 *PrepareBattleText(u32 id, const u8 *text)
+{
+    StringCopy(sBattleTexts[id], text);
+    BreakStringAutomatic(sBattleTexts[id], BATTLE_MSG_MAX_WIDTH, BATTLE_MSG_MAX_LINES, FONT_NORMAL, SHOW_SCROLL_PROMPT);
+    return sBattleTexts[id];
+}
+
+void HoL_SetBattleParams(void)
+{
+    u32 a = HoL_GetLeagueRoomOpponent(0);
+    u32 b = HoL_GetLeagueRoomOpponent(1);
+
+    gHoLOpponentsMerged = FALSE;
+
+    InitTrainerBattleParameter();
+    TRAINER_BATTLE_PARAM.opponentA = gHoLCharacters[a].trainerId;
+    TRAINER_BATTLE_PARAM.defeatTextA = PrepareBattleText(BATTLE_TEXT_DEFEAT_A, gHoLCharacters[a].defeatText);
+    TRAINER_BATTLE_PARAM.victoryText = PrepareBattleText(BATTLE_TEXT_VICTORY_A, gHoLCharacters[a].victoryText);
+    gBattleTypeFlags = BATTLE_TYPE_TRAINER;
+    if (gHoLRun.format != HOL_FORMAT_SINGLES)
+        gBattleTypeFlags |= BATTLE_TYPE_DOUBLE;
+    if (b != HOL_CHAR_NONE)
+    {
+        TRAINER_BATTLE_PARAM.opponentB = gHoLCharacters[b].trainerId;
+        TRAINER_BATTLE_PARAM.defeatTextB = PrepareBattleText(BATTLE_TEXT_DEFEAT_B, gHoLCharacters[b].defeatText);
+        PrepareBattleText(BATTLE_TEXT_VICTORY_B, gHoLCharacters[b].victoryText);
+        gBattleTypeFlags |= BATTLE_TYPE_TWO_OPPONENTS;
+    }
+}
