+
+EWRAM_DATA u8 gHoLPartnerMovement[16] = {0};
+
+static bool32 IsFreeForPartner(s16 x, s16 y, struct ObjectEvent *player, u32 followerId)
+{
+    u32 objectId = GetObjectEventIdByXY(x, y);
+
+    if (MapGridGetCollisionAt(x, y))
+        return FALSE;
+    if (x == player->currentCoords.x && y == player->currentCoords.y)
+        return FALSE;
+    return objectId == OBJECT_EVENTS_COUNT || objectId == followerId;
+}
+
+static u32 DirectionTo(s16 dx, s16 dy)
+{
+    if (dx < 0)
+        return DIR_WEST;
+    if (dx > 0)
+        return DIR_EAST;
+    return dy < 0 ? DIR_NORTH : DIR_SOUTH;
+}
+
+// Fills gHoLPartnerMovement with the shortest walk (around you and everyone else) that takes your partner to
+// (tx, ty), then a turn to faceDir. FALSE if there's no partner, it's hidden, or there's no way there.
+static bool32 PlanPartnerWalk(s16 tx, s16 ty, u32 faceDir)
+{
+    enum { AREA = 11, RADIUS = AREA / 2 };
+    static const s8 sSteps[4][2] = {{0, 1}, {0, -1}, {-1, 0}, {1, 0}};
+    static const u8 sStepDirs[4] = {DIR_SOUTH, DIR_NORTH, DIR_WEST, DIR_EAST};
+    struct ObjectEvent *player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    struct ObjectEvent *follower;
+    u32 followerId, i, n, head = 0, tail = 0;
+    s16 sx, sy, fx, fy;
+    u8 from[AREA * AREA], queue[AREA * AREA], path[AREA * AREA];
+
+    if (!HoL_PlayerHasPartner() || !PlayerHasFollowerNPC())
+        return FALSE;
+    followerId = GetFollowerNPCObjectId();
+    if (followerId == OBJECT_EVENTS_COUNT)
+        return FALSE;
+    follower = &gObjectEvents[followerId];
+    if (follower->invisible)
+        return FALSE;
+    sx = player->currentCoords.x - RADIUS;
+    sy = player->currentCoords.y - RADIUS;
+    fx = follower->currentCoords.x;
+    fy = follower->currentCoords.y;
+    if (tx < sx || tx >= sx + AREA || ty < sy || ty >= sy + AREA || fx < sx || fx >= sx + AREA || fy < sy || fy >= sy + AREA)
+        return FALSE;
+    if (!IsFreeForPartner(tx, ty, player, followerId))
+        return FALSE;
+
+    // Breadth-first from the partner
+    memset(from, 0xFF, sizeof(from));
+    i = (fy - sy) * AREA + (fx - sx);
+    from[i] = 4;
+    queue[tail++] = i;
+    while (head < tail)
+    {
+        u32 cur = queue[head++];
+        s16 cx = sx + cur % AREA, cy = sy + cur / AREA;
+
+        if (cx == tx && cy == ty)
+            break;
+        for (n = 0; n < 4; n++)
+        {
+            s16 nx = cx + sSteps[n][0], ny = cy + sSteps[n][1];
+            u32 next = (ny - sy) * AREA + (nx - sx);
+
+            if (nx < sx || nx >= sx + AREA || ny < sy || ny >= sy + AREA || from[next] != 0xFF)
+                continue;
+            if (!IsFreeForPartner(nx, ny, player, followerId))
+                continue;
+            from[next] = n;
+            queue[tail++] = next;
+        }
+    }
+    i = (ty - sy) * AREA + (tx - sx);
+    if (from[i] == 0xFF)
+        return FALSE;
+
+    // Walk it back from the target, then write the steps in order and the turn
+    n = 0;
+    while (from[i] != 4)
+    {
+        u32 step = from[i];
+        path[n++] = step;
+        i -= sSteps[step][1] * AREA + sSteps[step][0];
+    }
+    if (n + 2 > ARRAY_COUNT(gHoLPartnerMovement))
+        return FALSE;
+    for (i = 0; i < n; i++)
+        gHoLPartnerMovement[i] = GetWalkNormalMovementAction(sStepDirs[path[n - 1 - i]]);
+    gHoLPartnerMovement[n++] = GetFaceDirectionMovementAction(faceDir);
+    gHoLPartnerMovement[n] = MOVEMENT_ACTION_STEP_END;
+    return TRUE;
+}
+
+// Tag battles against two trainers: when you talk to one of them, your partner walks up next to you to stand in
+// front of the other one. VAR_RESULT: TRUE if gHoLPartnerMovement was filled in for applymovement.
+void HoL_LineUpPartner(void)
+{
+    struct ObjectEvent *player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    struct ObjectEvent *talked, *other;
+    u32 talkedId, otherId;
+    s16 tx, ty;
+
+    gSpecialVar_Result = FALSE;
+    if (!HoL_PlayerHasPartner() || HoL_GetLeagueRoomOpponent(1) == HOL_CHAR_NONE)
+        return;
+    talkedId = GetObjectEventIdByLocalIdAndMap(gSpecialVar_LastTalked, gSaveBlock1Ptr->location.mapNum, gSaveBlock1Ptr->location.mapGroup);
+    otherId = GetObjectEventIdByLocalIdAndMap(gSpecialVar_LastTalked == LOCALID_HOL_TRAINER_A ? LOCALID_HOL_TRAINER_B : LOCALID_HOL_TRAINER_A,
+                                              gSaveBlock1Ptr->location.mapNum, gSaveBlock1Ptr->location.mapGroup);
+    if (talkedId == OBJECT_EVENTS_COUNT || otherId == OBJECT_EVENTS_COUNT)
+        return;
+    talked = &gObjectEvents[talkedId];
+    other = &gObjectEvents[otherId];
+
+    // Stand in front of the other trainer the way you stand in front of the one you talked to
+    tx = other->currentCoords.x + player->currentCoords.x - talked->currentCoords.x;
+    ty = other->currentCoords.y + player->currentCoords.y - talked->currentCoords.y;
+    gSpecialVar_Result = PlanPartnerWalk(tx, ty, DirectionTo(other->currentCoords.x - tx, other->currentCoords.y - ty));
+}
+
+// Tag battles, after walking into a room: your partner steps up beside you (right side if free, else left),
+// facing the way you face. VAR_RESULT: TRUE if gHoLPartnerMovement was filled in for applymovement.
+void HoL_PartnerStepBeside(void)
+{
+    struct ObjectEvent *player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    u32 dir = player->facingDirection;
+    s16 x = player->currentCoords.x, y = player->currentCoords.y;
+    s16 rx, ry;
+
+    // "Right" of the way you face, as seen on screen for north/south
+    if (dir == DIR_NORTH || dir == DIR_SOUTH)
+        rx = 1, ry = 0;
+    else
+        rx = 0, ry = 1;
+    gSpecialVar_Result = PlanPartnerWalk(x + rx, y + ry, dir) || PlanPartnerWalk(x - rx, y - ry, dir);
+}
