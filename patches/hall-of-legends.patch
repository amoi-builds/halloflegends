diff --git a/data/scripts/hall_of_legends.inc b/data/scripts/hall_of_legends.inc
new file mode 100644
index 000000000..dfe33a29e
--- /dev/null
+++ b/data/scripts/hall_of_legends.inc
@@ -0,0 +1,151 @@
+@ Hall of Legends: shared scripts for the league rooms.
+
+@ Start menu > QUIT
+HallOfLegends_EventScript_QuitPrompt::
+	lockall
+	msgbox HallOfLegends_Text_QuitPrompt, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, HallOfLegends_EventScript_QuitCancel
+	goto HallOfLegends_EventScript_BackToSelect
+
+HallOfLegends_EventScript_QuitCancel::
+	releaseall
+	end
+
+HallOfLegends_EventScript_BackToSelect::
+	fadescreen FADE_TO_BLACK
+	special HoL_ReturnToSelect
+	end
+
+HallOfLegends_Text_QuitPrompt::
+	.string "Leave the HALL OF LEGENDS and go\n"
+	.string "back to TRAINER select?$"
+
+.if IS_FRLG
+
+@ Run from each room's MAP_SCRIPT_ON_TRANSITION with VAR_0x8004 = room.
+HallOfLegends_EventScript_SetupRoom::
+	special HoL_SetupRoom
+	return
+
+@ Talking to the trainer (or either of the two) in a league room.
+@ Returns only when there's nothing more to do here (VAR_RESULT FALSE), or when an Elite Four
+@ room was just cleared (VAR_RESULT TRUE) so the room can open its door.
+HallOfLegends_EventScript_TalkToTrainer::
+	lock
+	faceplayer
+	goto_if_set FLAG_HOL_ROOM_CLEARED, HallOfLegends_EventScript_TalkAfterBattle
+	special HoL_LineUpPartner
+	call_if_eq VAR_RESULT, TRUE, HallOfLegends_EventScript_PartnerStepsUp
+	setvar VAR_0x8005, HOL_TEXT_INTRO
+	call HallOfLegends_EventScript_TrainersSpeak
+	special BattleSetup_StartHallOfLegendsBattle
+	goto_if_eq VAR_RESULT, FALSE, HallOfLegends_EventScript_Lost
+	setflag FLAG_HOL_ROOM_CLEARED
+	setvar VAR_0x8005, HOL_TEXT_POST
+	call HallOfLegends_EventScript_TrainersSpeak
+	special HoL_GetRoomType
+	goto_if_eq VAR_RESULT, HOL_ROOM_TYPE_VERSUS, HallOfLegends_EventScript_WonVersus
+	goto_if_eq VAR_RESULT, HOL_ROOM_TYPE_FINAL, HallOfLegends_EventScript_WonEliteFour
+	setvar VAR_RESULT, TRUE
+	return
+
+@ Tag battles, after the walk into a room: your partner steps up beside you.
+HallOfLegends_EventScript_PartnerStepBeside::
+	special HoL_PartnerStepBeside
+	call_if_eq VAR_RESULT, TRUE, HallOfLegends_EventScript_PartnerStepsUp
+	return
+
+@ Tag battles: your partner walks up to face the other trainer.
+HallOfLegends_EventScript_PartnerStepsUp::
+	applymovement OBJ_EVENT_ID_NPC_FOLLOWER, gHoLPartnerMovement
+	waitmovement OBJ_EVENT_ID_NPC_FOLLOWER
+	return
+
+HallOfLegends_EventScript_TalkAfterBattle::
+	setvar VAR_0x8005, HOL_TEXT_POST
+	call HallOfLegends_EventScript_TrainersSpeak
+	setvar VAR_RESULT, FALSE
+	return
+
+@ VAR_0x8005: HOL_TEXT_INTRO or HOL_TEXT_POST. Both trainers speak in a tag battle.
+HallOfLegends_EventScript_TrainersSpeak::
+	setvar VAR_0x8004, 0
+	special HoL_BufferTrainerText
+	msgbox gStringVar4, MSGBOX_DEFAULT
+	setvar VAR_0x8004, 1
+	special HoL_BufferTrainerText
+	call_if_eq VAR_RESULT, TRUE, HallOfLegends_EventScript_SecondTrainerSpeaks
+	closemessage
+	return
+
+HallOfLegends_EventScript_SecondTrainerSpeaks::
+	msgbox gStringVar4, MSGBOX_DEFAULT
+	return
+
+HallOfLegends_EventScript_Lost::
+	special HoL_GetRoomType
+	call_if_eq VAR_RESULT, HOL_ROOM_TYPE_VERSUS, HallOfLegends_EventScript_LostVersus
+	call_if_ne VAR_RESULT, HOL_ROOM_TYPE_VERSUS, HallOfLegends_EventScript_LostEliteFour
+	goto HallOfLegends_EventScript_BackToSelect
+
+HallOfLegends_EventScript_LostVersus::
+	setvar VAR_0x8004, HOL_RESULT_LOST
+	call HallOfLegends_EventScript_ShowResult
+	return
+
+HallOfLegends_EventScript_LostEliteFour::
+	setvar VAR_0x8004, HOL_RESULT_LOST_ELITE_FOUR
+	call HallOfLegends_EventScript_ShowResult
+	return
+
+HallOfLegends_EventScript_WonVersus::
+	setvar VAR_0x8004, HOL_RESULT_WON
+	call HallOfLegends_EventScript_ShowResult
+	goto HallOfLegends_EventScript_BackToSelect
+
+HallOfLegends_EventScript_WonEliteFour::
+	setvar VAR_0x8004, HOL_RESULT_WON_ELITE_FOUR
+	call HallOfLegends_EventScript_ShowResult
+	closemessage
+	fadescreen FADE_TO_BLACK
+	warp MAP_POKEMON_LEAGUE_HALL_OF_FAME, 5, 12
+	waitstate
+	releaseall
+	end
+
+@ VAR_0x8004: HOL_RESULT_* (names both of your trainers in tag battles)
+HallOfLegends_EventScript_ShowResult::
+	special HoL_BufferResultText
+	msgbox gStringVar4, MSGBOX_DEFAULT
+	return
+
+@ Talking to a Pokémon in the team display.
+HallOfLegends_EventScript_TeamMon::
+	lock
+	special HoL_PlayTalkedMonCry
+	waitmoncry
+	release
+	end
+
+@ Hall of Fame room, after the Champion falls in an Elite Four run.
+HallOfLegends_EventScript_HallOfFame::
+	lockall
+	applymovement LOCALID_PLAYER, PokemonLeague_HallOfFame_Movement_EnterRoom
+	waitmovement 0
+	call HallOfLegends_EventScript_PartnerStepBeside
+	delay 20
+	setvar VAR_0x8004, HOL_RESULT_HALL_OF_FAME
+	call HallOfLegends_EventScript_ShowResult
+	closemessage
+	delay 20
+	dofieldeffect FLDEFF_HALL_OF_FAME_RECORD_FRLG
+	waitfieldeffect FLDEFF_HALL_OF_FAME_RECORD_FRLG
+	delay 40
+	setvar VAR_TEMP_1, 1
+	fadescreenspeed FADE_TO_BLACK, 24
+	special EnterHallOfFame
+	waitstate
+	releaseall
+	end
+
+.endif
