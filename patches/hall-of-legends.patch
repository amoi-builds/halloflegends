+// ---------------------------------------------------------------------------
+// Graphics
+
+static void WriteTilePixel(u8 *tile, u32 x, u32 y, u32 color)
+{
+    u8 *byte = &tile[y * 4 + x / 2];
+    if (x & 1)
+        *byte = (*byte & 0x0F) | (color << 4);
+    else
+        *byte = (*byte & 0xF0) | color;
+}
+
+static void FillTile(u8 *tile, u32 color)
+{
+    u32 x, y;
+    for (y = 0; y < 8; y++)
+        for (x = 0; x < 8; x++)
+            WriteTilePixel(tile, x, y, color);
+}
+
+// A cell frame piece: edges on the given sides get a 1px border.
+static void MakeCellTile(u8 *tile, bool32 top, bool32 bottom, bool32 left, bool32 right)
+{
+    u32 x, y;
+    FillTile(tile, COLOR_CELL);
+    for (y = 0; y < 8; y++)
+    {
+        for (x = 0; x < 8; x++)
+        {
+            if ((top && y == 0) || (bottom && y == 7) || (left && x == 0) || (right && x == 7))
+                WriteTilePixel(tile, x, y, COLOR_CELL_BORDER);
+        }
+    }
+}
+
+static void LoadBackgroundGfx(void)
+{
+    u8 *tiles = AllocZeroed(BGTILE_COUNT * TILE_SIZE_4BPP);
+    u32 x, y;
+
+    FillTile(&tiles[BGTILE_BACKDROP * TILE_SIZE_4BPP], COLOR_BACKDROP);
+    FillTile(&tiles[BGTILE_BLACK * TILE_SIZE_4BPP], COLOR_BLACK);
+    for (y = 0; y < 8; y++)
+    {
+        for (x = 0; x < 8; x++)
+        {
+            bool32 light = ((x + y) & 7) < 4;
+            WriteTilePixel(&tiles[BGTILE_STRIPES_RED * TILE_SIZE_4BPP], x, y, light ? COLOR_RED_LIGHT : COLOR_RED_DARK);
+            WriteTilePixel(&tiles[BGTILE_STRIPES_BLUE * TILE_SIZE_4BPP], x, y, light ? COLOR_BLUE_LIGHT : COLOR_BLUE_DARK);
+        }
+    }
+    FillTile(&tiles[BGTILE_HEADER * TILE_SIZE_4BPP], COLOR_HEADER);
+    FillTile(&tiles[BGTILE_HEADER_EDGE * TILE_SIZE_4BPP], COLOR_HEADER);
+    for (x = 0; x < 8; x++)
+        WriteTilePixel(&tiles[BGTILE_HEADER_EDGE * TILE_SIZE_4BPP], x, 7, COLOR_HEADER_EDGE);
+    FillTile(&tiles[BGTILE_GRID * TILE_SIZE_4BPP], COLOR_GRID);
+    MakeCellTile(&tiles[BGTILE_CELL_TL * TILE_SIZE_4BPP], TRUE, FALSE, TRUE, FALSE);
+    MakeCellTile(&tiles[BGTILE_CELL_T * TILE_SIZE_4BPP], TRUE, FALSE, FALSE, FALSE);
+    MakeCellTile(&tiles[BGTILE_CELL_TR * TILE_SIZE_4BPP], TRUE, FALSE, FALSE, TRUE);
+    MakeCellTile(&tiles[BGTILE_CELL_L * TILE_SIZE_4BPP], FALSE, FALSE, TRUE, FALSE);
+    MakeCellTile(&tiles[BGTILE_CELL_C * TILE_SIZE_4BPP], FALSE, FALSE, FALSE, FALSE);
+    MakeCellTile(&tiles[BGTILE_CELL_R * TILE_SIZE_4BPP], FALSE, FALSE, FALSE, TRUE);
+    MakeCellTile(&tiles[BGTILE_CELL_BL * TILE_SIZE_4BPP], FALSE, TRUE, TRUE, FALSE);
+    MakeCellTile(&tiles[BGTILE_CELL_B * TILE_SIZE_4BPP], FALSE, TRUE, FALSE, FALSE);
+    MakeCellTile(&tiles[BGTILE_CELL_BR * TILE_SIZE_4BPP], FALSE, TRUE, FALSE, TRUE);
+    // Copied right away (the screen is off): LoadBgTiles would read the buffer later
+    CpuCopy16(tiles, (void *)BG_CHAR_ADDR(3), BGTILE_COUNT * TILE_SIZE_4BPP);
+    Free(tiles);
+    LoadPalette(sBgPalette, BG_PLTT_ID(0), PLTT_SIZE_4BPP);
+    LoadPalette(sTextPalette, BG_PLTT_ID(PAL_TEXT), PLTT_SIZE_4BPP);
+
+    // Scrolling stripes behind the portraits: your side red, the other side blue, black between them
+    FillBgTilemapBufferRect(2, BGTILE_STRIPES_RED, 0, 0, 10, 32, 0);
+    FillBgTilemapBufferRect(2, BGTILE_BLACK, 10, 0, 10, 32, 0);
+    FillBgTilemapBufferRect(2, BGTILE_STRIPES_BLUE, 20, 0, 12, 32, 0);
+    // Header and grid panel in front of them
+    FillBgTilemapBufferRect(3, BGTILE_HEADER, 0, 0, 32, 1, 0);
+    FillBgTilemapBufferRect(3, BGTILE_HEADER_EDGE, 0, 1, 32, 1, 0);
+    FillBgTilemapBufferRect(3, BGTILE_GRID, 0, GRID_TOP, 32, 20 - GRID_TOP, 0);
+}
+
+static void DrawCellFrame(u32 x, u32 y, u32 w, u32 h)
+{
+    FillBgTilemapBufferRect(3, BGTILE_CELL_C, x, y, w, h, 0);
+    FillBgTilemapBufferRect(3, BGTILE_CELL_T, x, y, w, 1, 0);
+    FillBgTilemapBufferRect(3, BGTILE_CELL_B, x, y + h - 1, w, 1, 0);
+    FillBgTilemapBufferRect(3, BGTILE_CELL_L, x, y, 1, h, 0);
+    FillBgTilemapBufferRect(3, BGTILE_CELL_R, x + w - 1, y, 1, h, 0);
+    FillBgTilemapBufferRect(3, BGTILE_CELL_TL, x, y, 1, 1, 0);
+    FillBgTilemapBufferRect(3, BGTILE_CELL_TR, x + w - 1, y, 1, 1, 0);
+    FillBgTilemapBufferRect(3, BGTILE_CELL_BL, x, y + h - 1, 1, 1, 0);
+    FillBgTilemapBufferRect(3, BGTILE_CELL_BR, x + w - 1, y + h - 1, 1, 1, 0);
+}
+
+// Copies a widthTiles x CELL_HEIGHT tile window starting at pixel (x0, y0) of a 64x64 4bpp pic.
+static void CropFace(const u8 *pic, u8 *face, u32 x0, u32 y0, u32 widthTiles)
+{
+    u32 x, y;
+
+    memset(face, 0, widthTiles * CELL_HEIGHT * TILE_SIZE_4BPP);
+    for (y = 0; y < CELL_HEIGHT * 8; y++)
+    {
+        for (x = 0; x < widthTiles * 8; x++)
+        {
+            u32 sx = x0 + x, sy = y0 + y;
+            u32 src = pic[((sy / 8) * 8 + sx / 8) * TILE_SIZE_4BPP + (sy % 8) * 4 + (sx % 8) / 2];
+            u32 color = (sx & 1) ? src >> 4 : src & 0xF;
+
+            face[((y / 8) * widthTiles + x / 8) * TILE_SIZE_4BPP + (y % 8) * 4 + (x % 8) / 2] |= (x & 1) ? color << 4 : color;
+        }
+    }
+}
+
+// The faces in the grid are cut out of each trainer's front pic.
+static void LoadGrid(void)
+{
+    u8 *pic = Alloc(TRAINER_PIC_SIZE);
+    u8 *face = Alloc(TILE_SIZE_4BPP * 4 * CELL_HEIGHT);
+    u32 i, numFaces = 0;
+
+    sSelect->numCells = 0;
+    for (i = 0; i < HOL_CHAR_COUNT; i++)
+    {
+        if (gHoLCharacters[i].enabled)
+            sSelect->cells[sSelect->numCells++] = i;
+    }
+    sSelect->cells[sSelect->numCells++] = CELL_RANDOM;
+    sSelect->cells[sSelect->numCells++] = CELL_ELITE_FOUR;
+    sSelect->cols = (sSelect->numCells + 1) / 2;
+    sSelect->cellWidth = sSelect->cols * 4 <= DISPLAY_TILE_WIDTH ? 4 : 3;
+
+    for (i = 0; i < sSelect->numCells; i++)
+    {
+        u32 cell = sSelect->cells[i];
+        u32 x = GetCellX(i), y = GetCellY(i);
+
+        DrawCellFrame(x, y, sSelect->cellWidth, CELL_HEIGHT);
+        if (IsCharacterCell(cell))
+        {
+            const struct HoLCharacter *info = &gHoLCharacters[cell];
+            s32 x0 = min(max((s32)info->faceX - sSelect->cellWidth * 4, 0), 64 - sSelect->cellWidth * 8);
+            s32 y0 = min(max((s32)info->faceY - FACE_EYE_ROW, 0), 64 - CELL_HEIGHT * 8);
+
+            DecompressDataWithHeaderWram(GetTrainerFrontPicData(info->frontPic), pic);
+            CropFace(pic, face, x0, y0, sSelect->cellWidth);
+            CpuCopy16(face, (void *)(BG_CHAR_ADDR(2) + (1 + numFaces * 16) * TILE_SIZE_4BPP), sSelect->cellWidth * CELL_HEIGHT * TILE_SIZE_4BPP);
+            LoadPalette(GetTrainerFrontPicPalette(info->frontPic), BG_PLTT_ID(PAL_FACE(numFaces)), PLTT_SIZE_4BPP);
+            // Let the cell show through the pic's background color
+            gPlttBufferUnfaded[BG_PLTT_ID(PAL_FACE(numFaces))] = sBgPalette[COLOR_CELL];
+            WriteSequenceToBgTilemapBuffer(1, 1 + numFaces * 16, x, y, sSelect->cellWidth, CELL_HEIGHT, PAL_FACE(numFaces), 1);
+            numFaces++;
+        }
+    }
+    Free(face);
+    Free(pic);
+}
+
+static void CreateCellLabels(void)
+{
+    u32 i, n = 0;
+
+    for (i = 0; i < sSelect->numCells && n < 2; i++)
+    {
+        struct WindowTemplate template = {
+            .bg = 0,
+            .tilemapLeft = GetCellX(i),
+            .tilemapTop = GetCellY(i),
+            .width = sSelect->cellWidth,
+            .height = CELL_HEIGHT,
+            .paletteNum = PAL_TEXT,
+            .baseBlock = CELL_WINDOW_BASE_BLOCK + n * 16,
+        };
+        if (IsCharacterCell(sSelect->cells[i]))
+            continue;
+        sSelect->cellWindows[n] = AddWindow(&template);
+        FillWindowPixelBuffer(sSelect->cellWindows[n], PIXEL_FILL(0));
+        PutWindowTilemap(sSelect->cellWindows[n]);
+        n++;
+    }
+}
+
+static void PrintCellLabels(void)
+{
+    u32 i, n = 0;
+
+    for (i = 0; i < sSelect->numCells && n < 2; i++)
+    {
+        u32 cell = sSelect->cells[i];
+
+        if (IsCharacterCell(cell))
+            continue;
+        FillWindowPixelBuffer(sSelect->cellWindows[n], PIXEL_FILL(0));
+        if (cell == CELL_RANDOM)
+        {
+            PrintCentered(sSelect->cellWindows[n], sText_RandomCell, 8, sColor_Gold);
+        }
+        else
+        {
+            // Narrow cells (many characters) don't fit "ELITE" in the normal font
+            u32 fontId = GetStringWidth(FONT_NORMAL, sText_EliteFourCell1, 0) <= sSelect->cellWidth * 8 ? FONT_NORMAL : FONT_SMALL;
+            const u8 *color = IsEliteFourUnavailable() ? sColor_Dim : sColor_Gold;
+            PrintCenteredFont(sSelect->cellWindows[n], fontId, sText_EliteFourCell1, 2, color);
+            PrintCenteredFont(sSelect->cellWindows[n], fontId, sText_EliteFourCell2, 15, color);
+        }
+        CopyWindowToVram(sSelect->cellWindows[n], COPYWIN_FULL);
+        n++;
+    }
+}
+
+static void CreateCursor(void)
+{
+    u8 *tiles = AllocZeroed(16 * TILE_SIZE_4BPP);
+    struct SpriteSheet sheet = {tiles, 16 * TILE_SIZE_4BPP, TAG_CURSOR};
+    struct SpritePalette palette = {sCursorPalette, TAG_CURSOR};
+    u32 x, y, w = sSelect->cellWidth * 8;
+
+    // 1D mapped 32x32: tile (tx, ty) is at index ty * 4 + tx
+    for (y = 0; y < 32; y++)
+    {
+        for (x = 0; x < w; x++)
+        {
+            u32 color = 0;
+            if (x < 2 || x >= w - 2 || y < 2 || y >= 30)
+                color = 1;
+            else if (x == 2 || x == w - 3 || y == 2 || y == 29)
+                color = 2;
+            if (color)
+                WriteTilePixel(&tiles[((y / 8) * 4 + x / 8) * TILE_SIZE_4BPP], x % 8, y % 8, color);
+        }
+    }
+    LoadSpriteSheet(&sheet);
+    LoadSpritePalette(&palette);
+    Free(tiles);
+    sSelect->cursorSpriteId = CreateSprite(&sSpriteTemplate_Cursor, 0, 0, 0);
+    gSprites[sSelect->cursorSpriteId].invisible = TRUE;
+}
+
+static void UpdateCursor(void)
+{
+    struct Sprite *cursor = &gSprites[sSelect->cursorSpriteId];
+    u32 slot = GetActiveSlot();
+
+    if (slot == SLOT_COUNT)
+    {
+        cursor->invisible = TRUE;
+        return;
+    }
+    cursor->invisible = (sSelect->timer & 0x10) && !IsCellSelectable(sSelect->cells[sSelect->cursor]);
+    cursor->x = GetCellX(sSelect->cursor) * 8 + 16;
+    cursor->y = GetCellY(sSelect->cursor) * 8 + 16;
+    // Red for your side, blue for the other side; pulses
+    {
+        u32 shade = (sSelect->timer & 0x1F) < 16 ? (sSelect->timer & 0xF) : 31 - (sSelect->timer & 0x1F);
+        u16 color = IsOpponentStage() ? RGB(6 + shade / 2, 12 + shade / 2, 31) : RGB(31, 6 + shade / 2, 6 + shade / 2);
+        gPlttBufferFaded[OBJ_PLTT_ID(IndexOfSpritePaletteTag(TAG_CURSOR)) + 1] = color;
+        gPlttBufferUnfaded[OBJ_PLTT_ID(IndexOfSpritePaletteTag(TAG_CURSOR)) + 1] = color;
+    }
+}
