+// ---------------------------------------------------------------------------
+// Stages
+
+static void SetStage(u32 stage)
+{
+    u32 slot;
+
+    sSelect->stage = stage;
+    slot = GetActiveSlot();
+    if (slot != SLOT_COUNT)
+    {
+        // Going back: start on the pick being redone. The first pick starts on RED; otherwise the cursor
+        // stays where you just picked.
+        if (sSelect->picks[slot] != CELL_NONE)
+            sSelect->cursor = FindCellIndex(sSelect->picks[slot]);
+        else if (slot == SLOT_PLAYER_1)
+            sSelect->cursor = FindCellIndex(HOL_CHAR_RED);
+        sSelect->picks[slot] = CELL_NONE;
+    }
+    Refresh();
+}
+
+static void ResolvePicks(void)
+{
+    u8 taken[SLOT_COUNT];
+    u32 numTaken = 0, slot, i;
+
+    // Random never lands on a trainer that's already in the matchup
+    for (slot = 0; slot < SLOT_COUNT; slot++)
+    {
+        if (IsSlotUsed(slot) && IsCharacterCell(sSelect->picks[slot]))
+            taken[numTaken++] = sSelect->picks[slot];
+    }
+    for (slot = 0; slot < SLOT_COUNT; slot++)
+    {
+        u32 pick = sSelect->picks[slot];
+
+        if (!IsSlotUsed(slot) || pick == CELL_NONE)
+            sSelect->resolved[slot] = CELL_NONE;
+        else if (pick == CELL_RANDOM)
+        {
+            sSelect->resolved[slot] = PickRandomCharacter(taken, numTaken);
+            taken[numTaken++] = sSelect->resolved[slot];
+        }
+        else
+            sSelect->resolved[slot] = pick;
+    }
+
+    if (sSelect->picks[SLOT_OPPONENT_1] == CELL_ELITE_FOUR)
+    {
+        u8 exclude[SLOT_COUNT + HOL_E4_ROOM_COUNT];
+        u32 numExclude = 0, numEnabled = 0;
+
+        for (i = 0; i < HOL_CHAR_COUNT; i++)
+            numEnabled += gHoLCharacters[i].enabled;
+        exclude[numExclude++] = sSelect->resolved[SLOT_PLAYER_1];
+        if (IsTag())
+            exclude[numExclude++] = sSelect->resolved[SLOT_PLAYER_2];
+        if (numEnabled < numExclude + HOL_E4_ROOM_COUNT)
+            numExclude = 0; // not enough trainers to skip your own
+        for (i = 0; i < HOL_E4_ROOM_COUNT; i++)
+        {
+            sSelect->eliteFour[i] = PickRandomCharacter(exclude, numExclude);
+            exclude[numExclude++] = sSelect->eliteFour[i];
+        }
+    }
+}
+
+static void StartRun(u8 taskId)
+{
+    sLastFormat = sSelect->format;
+    sHasLastPicks = TRUE;
+
+    memset(&gHoLRun, 0, sizeof(gHoLRun));
+    gHoLRun.format = sSelect->format;
+    gHoLRun.players[0] = sSelect->resolved[SLOT_PLAYER_1];
+    gHoLRun.players[1] = IsTag() ? sSelect->resolved[SLOT_PLAYER_2] : HOL_CHAR_NONE;
+    if (sSelect->picks[SLOT_OPPONENT_1] == CELL_ELITE_FOUR)
+    {
+        gHoLRun.runType = HOL_RUN_ELITE_FOUR;
+        gHoLRun.opponents[0] = gHoLRun.opponents[1] = HOL_CHAR_NONE;
+        memcpy(gHoLRun.eliteFour, sSelect->eliteFour, sizeof(gHoLRun.eliteFour));
+    }
+    else
+    {
+        gHoLRun.runType = HOL_RUN_VERSUS;
+        gHoLRun.opponents[0] = sSelect->resolved[SLOT_OPPONENT_1];
+        gHoLRun.opponents[1] = IsTag() ? sSelect->resolved[SLOT_OPPONENT_2] : HOL_CHAR_NONE;
+    }
+    gHoLRun.active = TRUE;
+#if IS_FRLG
+    // NewGameInitData keeps the rival's name, and expects one (normally set in the intro)
+    StringCopy(gSaveBlock1Ptr->rivalName, gHoLCharacters[HOL_CHAR_BLUE].name);
+#endif
+
+    sSelect->stage = STAGE_START;
+    PlaySE(SE_RG_DOOR);
+    FadeOutBGM(4);
+    BeginNormalPaletteFade(PALETTES_ALL, 2, 0, 16, RGB_BLACK);
+    gTasks[taskId].func = Task_HoLSelect_FadeOut;
+}
+
+static void MoveCursor(s32 dx, s32 dy)
+{
+    s32 cols = sSelect->cols;
+    s32 index = sSelect->cursor;
+    s32 row = index / cols, col = index % cols;
+    s32 rowCount;
+
+    if (dy != 0)
+    {
+        // Go to the closest cell in the other row (the rows can differ in length)
+        s32 x = GetCellX(index), best = 0, bestDist = 0x7FFF, i;
+        row = (row + 1) % 2;
+        rowCount = row == 0 ? cols : sSelect->numCells - cols;
+        for (i = 0; i < rowCount; i++)
+        {
+            s32 dist = abs((s32)GetCellX(row * cols + i) - x);
+            if (dist < bestDist)
+            {
+                bestDist = dist;
+                best = i;
+            }
+        }
+        col = best;
+    }
+    else
+    {
+        rowCount = row == 0 ? cols : sSelect->numCells - cols;
+        col = (col + dx + rowCount) % rowCount;
+    }
+    sSelect->cursor = row * cols + col;
+    PlaySE(SE_SELECT);
+    Refresh();
+}
+
+static void HandleGridInput(u8 taskId)
+{
+    u32 slot = GetActiveSlot();
+    u32 cell = sSelect->cells[sSelect->cursor];
+
+    if (JOY_REPEAT(DPAD_LEFT))
+        MoveCursor(-1, 0);
+    else if (JOY_REPEAT(DPAD_RIGHT))
+        MoveCursor(1, 0);
+    else if (JOY_REPEAT(DPAD_UP | DPAD_DOWN))
+        MoveCursor(0, 1);
+    else if (JOY_NEW(A_BUTTON))
+    {
+        if (!IsCellSelectable(cell))
+        {
+            PlaySE(SE_FAILURE);
+            return;
+        }
+        sSelect->picks[slot] = cell;
+        PlaySE(SE_SUCCESS);
+        if (IsCharacterCell(cell))
+            PlayCry_Normal(GetTrainerStructFromId(gHoLCharacters[cell].trainerId)->party[0].species, 0);
+        switch (sSelect->stage)
+        {
+        case STAGE_PLAYER_1:
+            SetStage(IsTag() ? STAGE_PLAYER_2 : STAGE_OPPONENT_1);
+            break;
+        case STAGE_PLAYER_2:
+            SetStage(STAGE_OPPONENT_1);
+            break;
+        case STAGE_OPPONENT_1:
+            if (IsTag() && cell != CELL_ELITE_FOUR)
+                SetStage(STAGE_OPPONENT_2);
+            else
+            {
+                ResolvePicks();
+                SetStage(STAGE_CONFIRM);
+            }
+            break;
+        case STAGE_OPPONENT_2:
+            ResolvePicks();
+            SetStage(STAGE_CONFIRM);
+            break;
+        }
+    }
+    else if (JOY_NEW(B_BUTTON))
+    {
+        PlaySE(SE_SELECT);
+        switch (sSelect->stage)
+        {
+        case STAGE_PLAYER_1:
+            SetStage(STAGE_FORMAT);
+            break;
+        case STAGE_PLAYER_2:
+            SetStage(STAGE_PLAYER_1);
+            break;
+        case STAGE_OPPONENT_1:
+            SetStage(IsTag() ? STAGE_PLAYER_2 : STAGE_PLAYER_1);
+            break;
+        case STAGE_OPPONENT_2:
+            SetStage(STAGE_OPPONENT_1);
+            break;
+        }
+    }
+}
+
+static void Task_HoLSelect(u8 taskId)
+{
+    if (gPaletteFade.active)
+        return;
+
+    sSelect->timer++;
+    if (sSelect->timer % ROULETTE_FRAMES == 0)
+    {
+        AdvanceRoulette();
+        UpdatePortraits();
+    }
+    UpdateCursor();
+
+    switch (sSelect->stage)
+    {
+    case STAGE_FORMAT:
+        if (sSelect->showCredits)
+        {
+            // A/SELECT: next page, B/START (or A on the last page): back
+            if (JOY_NEW(A_BUTTON | B_BUTTON | SELECT_BUTTON | START_BUTTON))
+            {
+                if (JOY_NEW(A_BUTTON | SELECT_BUTTON) && sSelect->showCredits < ARRAY_COUNT(sCreditPages))
+                    sSelect->showCredits++;
+                else
+                    sSelect->showCredits = 0;
+                PlaySE(SE_SELECT);
+                PrintCenter();
+            }
+        }
+        else if (JOY_NEW(SELECT_BUTTON))
+        {
+            sSelect->showCredits = 1;
+            PlaySE(SE_SELECT);
+            PrintCenter();
+        }
+        else if (JOY_NEW(DPAD_UP))
+        {
+            sSelect->formatCursor = (sSelect->formatCursor + ARRAY_COUNT(sFormatNames) - 1) % ARRAY_COUNT(sFormatNames);
+            PlaySE(SE_SELECT);
+            PrintCenter();
+        }
+        else if (JOY_NEW(DPAD_DOWN))
+        {
+            sSelect->formatCursor = (sSelect->formatCursor + 1) % ARRAY_COUNT(sFormatNames);
+            PlaySE(SE_SELECT);
+            PrintCenter();
+        }
+        else if (JOY_NEW(A_BUTTON | START_BUTTON))
+        {
+            u32 slot;
+            if (sSelect->format != sSelect->formatCursor)
+            {
+                // A different style starts the picks over
+                for (slot = 0; slot < SLOT_COUNT; slot++)
+                    sSelect->picks[slot] = CELL_NONE;
+            }
+            sSelect->format = sSelect->formatCursor;
+            PlaySE(SE_SELECT);
+            SetStage(STAGE_PLAYER_1);
+        }
+        break;
+    case STAGE_PLAYER_1:
+    case STAGE_PLAYER_2:
+    case STAGE_OPPONENT_1:
+    case STAGE_OPPONENT_2:
+        HandleGridInput(taskId);
+        break;
+    case STAGE_CONFIRM:
+        if (JOY_NEW(A_BUTTON | START_BUTTON))
+        {
+            StartRun(taskId);
+        }
+        else if (JOY_NEW(B_BUTTON))
+        {
+            PlaySE(SE_SELECT);
+            if (IsTag() && sSelect->picks[SLOT_OPPONENT_1] != CELL_ELITE_FOUR)
+                SetStage(STAGE_OPPONENT_2);
+            else
+                SetStage(STAGE_OPPONENT_1);
+        }
+        break;
+    }
+}
+
+static void FreeSelectResources(void)
+{
+    u32 slot;
+
+    DestroyTeamIcons();
+    for (slot = 0; slot < SLOT_COUNT; slot++)
+    {
+        if (sSelect->shown[slot] != CELL_NONE)
+            FreeAndDestroyTrainerPicSprite(sSelect->picSpriteIds[slot]);
+    }
+    FreeMonIconPalettes();
+    FreeAllWindowBuffers();
+    UnsetBgTilemapBuffer(1);
+    UnsetBgTilemapBuffer(2);
+    UnsetBgTilemapBuffer(3);
+    FREE_AND_SET_NULL(sSelect);
+}
+
+static void Task_HoLSelect_FadeOut(u8 taskId)
+{
+    if (gPaletteFade.active)
+        return;
+    DestroyTask(taskId);
+    FreeSelectResources();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    SetVBlankCallback(NULL);
+    SetMainCallback2(CB2_NewGame);
+}
