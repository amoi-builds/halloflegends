+{
+    switch (sSelect->stage)
+    {
+    case STAGE_PLAYER_1:
+        return cell != CELL_ELITE_FOUR;
+    case STAGE_PLAYER_2:
+        return cell != CELL_ELITE_FOUR && (cell == CELL_RANDOM || cell != sSelect->picks[SLOT_PLAYER_1]);
+    case STAGE_OPPONENT_1:
+        return TRUE;
+    case STAGE_OPPONENT_2:
+        return cell != CELL_ELITE_FOUR && (cell == CELL_RANDOM || cell != sSelect->picks[SLOT_OPPONENT_1]);
+    }
+    return FALSE;
+}
+
+static u32 GetCellX(u32 cellIndex)
+{
+    u32 col = cellIndex % sSelect->cols;
+    u32 row = cellIndex / sSelect->cols;
+    u32 rowCount = row == 0 ? sSelect->cols : sSelect->numCells - sSelect->cols;
+    u32 left = (DISPLAY_TILE_WIDTH - rowCount * sSelect->cellWidth) / 2;
+    return left + col * sSelect->cellWidth;
+}
+
+static u32 GetCellY(u32 cellIndex)
+{
+    return GRID_TOP + (cellIndex / sSelect->cols) * CELL_HEIGHT;
+}
+
+static u32 FindCellIndex(u32 cell)
+{
+    u32 i;
+    for (i = 0; i < sSelect->numCells; i++)
+    {
+        if (sSelect->cells[i] == cell)
+            return i;
+    }
+    return 0;
+}
+
+// A random enabled character that isn't in the exclude list.
+static u32 PickRandomCharacter(const u8 *exclude, u32 numExclude)
+{
+    u8 candidates[HOL_CHAR_COUNT];
+    u32 count = 0, i, j;
+
+    for (i = 0; i < HOL_CHAR_COUNT; i++)
+    {
+        if (!gHoLCharacters[i].enabled)
+            continue;
+        for (j = 0; j < numExclude; j++)
+        {
+            if (exclude[j] == i)
+                break;
+        }
+        if (j == numExclude)
+            candidates[count++] = i;
+    }
+    if (count == 0)
+        return HOL_CHAR_RED;
+    return candidates[Random() % count];
+}
