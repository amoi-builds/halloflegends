+
+static void VBlankCB_HoLSelect(void)
+{
+    LoadOam();
+    ProcessSpriteCopyRequests();
+    TransferPlttBuffer();
+    ChangeBgY(2, 0x40, BG_COORD_ADD);
+}
+
+static void CB2_HoLSelect(void)
+{
+    RunTasks();
+    AnimateSprites();
+    BuildOamBuffer();
+    RunTextPrinters();
+    DoScheduledBgTilemapCopiesToVram();
+    UpdatePaletteFade();
+}
+
+void CB2_InitHallOfLegendsSelect(void)
+{
+    u32 i;
+
+    switch (gMain.state)
+    {
+    case 0:
+        SetVBlankCallback(NULL);
+        SetHBlankCallback(NULL);
+        SetGpuReg(REG_OFFSET_DISPCNT, 0);
+        ScanlineEffect_Stop();
+        DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+        DmaClear32(3, OAM, OAM_SIZE);
+        DmaClear16(3, PLTT, PLTT_SIZE);
+        ResetPaletteFade();
+        ResetTasks();
+        ResetSpriteData();
+        FreeAllSpritePalettes();
+        ResetAllPicSprites();
+        gHoLRun.active = FALSE;
+        gMain.state++;
+        break;
+    case 1:
+        sSelect = AllocZeroed(sizeof(*sSelect));
+        for (i = 0; i < SLOT_COUNT; i++)
+        {
+            sSelect->picks[i] = CELL_NONE;
+            sSelect->resolved[i] = CELL_NONE;
+            sSelect->shown[i] = CELL_NONE;
+        }
+        for (i = 0; i < PARTY_SIZE; i++)
+            sSelect->iconSpriteIds[i] = SPRITE_NONE;
+        sSelect->iconsFor = CELL_NONE;
+        sSelect->format = sSelect->formatCursor = sHasLastPicks ? sLastFormat : HOL_FORMAT_SINGLES;
+        sSelect->rouletteChar = HOL_CHAR_RED;
+
+        ResetBgsAndClearDma3BusyFlags(0);
+        InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+        // Coming back from the overworld: clear its scrolling, blending and windows
+        for (i = 0; i < NUM_BACKGROUNDS; i++)
+        {
+            ChangeBgX(i, 0, BG_COORD_SET);
+            ChangeBgY(i, 0, BG_COORD_SET);
+        }
+        SetGpuReg(REG_OFFSET_BLDCNT, 0);
+        SetGpuReg(REG_OFFSET_BLDALPHA, 0);
+        SetGpuReg(REG_OFFSET_BLDY, 0);
+        SetGpuReg(REG_OFFSET_WININ, 0);
+        SetGpuReg(REG_OFFSET_WINOUT, 0);
+        SetGpuReg(REG_OFFSET_MOSAIC, 0);
+        SetBgTilemapBuffer(1, sSelect->bg1Tilemap);
+        SetBgTilemapBuffer(2, sSelect->bg2Tilemap);
+        SetBgTilemapBuffer(3, sSelect->bg3Tilemap);
+        InitWindows(sWindowTemplates);
+        DeactivateAllTextPrinters();
+        gMain.state++;
+        break;
+    case 2:
+        LoadBackgroundGfx();
+        LoadGrid();
+        CreateCellLabels();
+        for (i = 0; i < WIN_COUNT; i++)
+            PutWindowTilemap(i);
+        CopyBgTilemapBufferToVram(1);
+        CopyBgTilemapBufferToVram(2);
+        CopyBgTilemapBufferToVram(3);
+        gMain.state++;
+        break;
+    case 3:
+        for (i = 0; i < PORTRAIT_PAL_COUNT; i++)
+            sSelect->portraitPal[i] = AllocSpritePalette(TAG_PORTRAIT_PAL + i);
+        LoadMonIconPalettes();
+        CreateCursor();
+        if (!sOptionsSet)
+        {
+            // Fast text and no switch prompts suit a battler. Still changeable from OPTION.
+            gSaveBlock2Ptr->optionsTextSpeed = OPTIONS_TEXT_SPEED_FAST;
+            gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SET;
+            sOptionsSet = TRUE;
+        }
+        gMain.state++;
+        break;
+    case 4:
+        // The style and your first trainer start on last time's choices (see SetStage)
+        SetStage(STAGE_FORMAT);
+        SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_OBJ_ON | DISPCNT_OBJ_1D_MAP);
+        ShowBg(0);
+        ShowBg(1);
+        ShowBg(2);
+        ShowBg(3);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+        SetVBlankCallback(VBlankCB_HoLSelect);
+        SetMainCallback2(CB2_HoLSelect);
+        PlayNewMapMusic(MUS_RG_TRAINER_TOWER);
+        CreateTask(Task_HoLSelect, 0);
+        break;
+    }
+}
