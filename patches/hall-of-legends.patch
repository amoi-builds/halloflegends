+static void PrintHeader(void)
+{
+    const u8 *str;
+
+    switch (sSelect->stage)
+    {
+    case STAGE_FORMAT:     str = sText_ChooseStyle; break;
+    case STAGE_PLAYER_1:   str = IsTag() ? sText_ChooseTrainer1 : sText_ChooseTrainer; break;
+    case STAGE_PLAYER_2:   str = sText_ChooseTrainer2; break;
+    case STAGE_OPPONENT_1: str = IsTag() ? sText_ChooseOpponent1 : sText_ChooseOpponent; break;
+    case STAGE_OPPONENT_2: str = sText_ChooseOpponent2; break;
+    default:               str = sText_Confirm; break;
+    }
+    if (GetSlotDisplay(SLOT_OPPONENT_1) == CELL_ELITE_FOUR && sSelect->stage == STAGE_OPPONENT_1)
+        str = sText_EliteFourDesc;
+    else if (IsEliteFourUnavailable() && sSelect->cells[sSelect->cursor] == CELL_ELITE_FOUR)
+        str = IsPickingPlayers() ? sText_EliteFourOpponentsOnly : sText_EliteFourFirstOpponent;
+    else if (IsSecondPick() && IsCharacterCell(sSelect->cells[sSelect->cursor]) && !IsCellSelectable(sSelect->cells[sSelect->cursor]))
+    {
+        StringCopy(gStringVar4, gHoLCharacters[sSelect->cells[sSelect->cursor]].name);
+        StringAppend(gStringVar4, sText_AlreadyPicked);
+        str = gStringVar4;
+    }
+    FillWindowPixelBuffer(WIN_HEADER, PIXEL_FILL(0));
+    AddTextPrinterParameterized3(WIN_HEADER, FONT_NORMAL, 4, 1, sColor_White, TEXT_SKIP_DRAW, str);
+    if (sSelect->stage != STAGE_FORMAT)
+    {
+        const u8 *format = sFormatShortNames[sSelect->format];
+        AddTextPrinterParameterized3(WIN_HEADER, FONT_NORMAL, 236 - GetStringWidth(FONT_NORMAL, format, 0), 1, sColor_Gold, TEXT_SKIP_DRAW, format);
+    }
+    else
+    {
+        AddTextPrinterParameterized3(WIN_HEADER, FONT_SMALL, 236 - GetStringWidth(FONT_SMALL, sText_CreditsHint, 0), 3, sColor_Light, TEXT_SKIP_DRAW, sText_CreditsHint);
+    }
+    CopyWindowToVram(WIN_HEADER, COPYWIN_FULL);
+}
